{
  "title": "Release Health",
  "description": "Release frequency, success rate and rollback rate",
  "panels": [
    {
      "id": 1,
      "title": "Release Frequency (per week)",
      "type": "stat",
      "targets": [
        {
          "expr": "count(releases_total[7d])",
          "legendFormat": "Releases / week"
        }
      ]
    },
    {
      "id": 2,
      "title": "Deployment Success Rate",
      "type": "gauge",
      "targets": [
        {
          "expr": "sum(deployments_total{status='success'}) / sum(deployments_total) * 100",
          "legendFormat": "Deployment Success %"
        }
      ],
      "thresholds": {
        "mode": "absolute",
        "steps": [
          {"color": "red", "value": 0},
          {"color": "yellow", "value": 90},
          {"color": "green", "value": 98}
        ]
      }
    },
    {
      "id": 3,
      "title": "Rollback Rate",
      "type": "gauge",
      "targets": [
        {
          "expr": "sum(rollbacks_total) / sum(deployments_total) * 100",
          "legendFormat": "Rollback Rate %"
        }
      ],
      "thresholds": {
        "mode": "absolute",
        "steps": [
          {"color": "green", "value": 0},
          {"color": "yellow", "value": 5},
          {"color": "red", "value": 10}
        ]
      }
    },
    {
      "id": 4,
      "title": "Releases by Environment",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(deployments_total) by (environment)",
          "legendFormat": "{{environment}}"
        }
      ]
    }
  ],
  "refresh": "1h",
  "time": {"from": "now-30d", "to": "now"}
}
