# .env.example
# Copy this file to .env and fill in real values.
# Never commit .env with real values.

# GitHub Container Registry organisation
GHCR_ORG=kdd-agentic-race-engineering

# Default image tag used by scripts
IMAGE_TAG=main

# Kubeconfig path (for local kubectl usage)
KUBECONFIG_PATH=~/.kube/config

# Trivy severity threshold
TRIVY_SEVERITY=CRITICAL,HIGH

# Gitleaks config path
GITLEAKS_CONFIG=config/gitleaks/gitleaks.toml

# Release environment (local, staging, production)
RELEASE_ENV=local

# Cosign keyless signing (set to true for phase 3)
COSIGN_ENABLED=false
